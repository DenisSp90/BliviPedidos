@model BliviPedidos.Models.ViewModels.LojaPixViewModel
@{
    ViewData["Title"] = "PIX - " + Model.LojaNome;
}
<div class="pagetitle">
    <h1>Configuração PIX</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Loja" asp-action="Index">Lojas</a></li>
        <li class="breadcrumb-item active">@Model.Slug</li>
    </ol></nav>
</div>
<section class="section">
    @if (TempData["Sucesso"] is string sucesso) { <div class="alert alert-success">@sucesso</div> }
    <div class="card"><div class="card-body">
        <h5 class="card-title">PIX da loja @Model.LojaNome</h5>
        <p class="text-secondary">Endereço público: <code>/loja/@Model.Slug</code></p>
        <form method="post" class="row g-3">
            <input asp-for="LojaId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-12"><div class="form-check form-switch">
                <input asp-for="Ativo" class="form-check-input" />
                <label asp-for="Ativo" class="form-check-label"></label>
            </div></div>
            <div class="col-md-6">
                <label asp-for="Responsavel" class="form-label"></label>
                <input asp-for="Responsavel" class="form-control" />
                <span asp-validation-for="Responsavel" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Cidade" class="form-label"></label>
                <input asp-for="Cidade" class="form-control" placeholder="SAO PAULO" />
                <span asp-validation-for="Cidade" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Tipo" class="form-label"></label>
                <select asp-for="Tipo" class="form-select">
                    <option value="">Selecione</option><option>CPF</option><option>CNPJ</option>
                    <option value="Telefone">Telefone</option><option value="Email">E-mail</option>
                    <option value="ChaveAleatoria">Chave aleatória</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Chave" class="form-label"></label>
                <input asp-for="Chave" class="form-control" autocomplete="off" />
                <span asp-validation-for="Chave" class="text-danger"></span>
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Salvar configuração PIX</button>
                <a class="btn btn-light" asp-action="Index">Voltar</a>
            </div>
        </form>
    </div></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
