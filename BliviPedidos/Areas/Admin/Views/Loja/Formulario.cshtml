@model BliviPedidos.Models.ViewModels.LojaViewModel

@{
    var editando = Model.Id > 0;
    ViewData["Title"] = editando ? "Editar loja" : "Nova loja";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Administração</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Loja" asp-action="Index">Lojas</a></li>
            <li class="breadcrumb-item active">@(editando ? "Editar" : "Cadastrar")</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Identidade da loja</h5>

                    <form class="row g-3" method="post" asp-action="@(editando ? "Editar" : "Criar")" asp-route-id="@Model.Id">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-7">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" placeholder="Nome exibido da loja" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Slug" class="form-label"></label>
                            <input asp-for="Slug" class="form-control" placeholder="minha-loja" />
                            <span asp-validation-for="Slug" class="text-danger"></span>
                            <div class="form-text">Usado nas URLs públicas da loja.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Dominio" class="form-label"></label>
                            <input asp-for="Dominio" class="form-control" placeholder="loja.exemplo.com" />
                            <span asp-validation-for="Dominio" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="LogoUrl" class="form-label"></label>
                            <input asp-for="LogoUrl" class="form-control" placeholder="https://exemplo.com/logo.png" />
                            <span asp-validation-for="LogoUrl" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CorPrimaria" class="form-label"></label>
                            <div class="input-group">
                                <input id="seletorCor" type="color" class="form-control form-control-color" value="@Model.CorPrimaria" aria-label="Selecionar cor" />
                                <input asp-for="CorPrimaria" id="valorCor" class="form-control" />
                            </div>
                            <span asp-validation-for="CorPrimaria" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CorSecundaria" class="form-label"></label>
                            <div class="input-group">
                                <input id="seletorCorSecundaria" type="color" class="form-control form-control-color" value="@Model.CorSecundaria" aria-label="Selecionar cor secundária" />
                                <input asp-for="CorSecundaria" id="valorCorSecundaria" class="form-control" />
                            </div>
                            <span asp-validation-for="CorSecundaria" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descricao" class="form-label"></label>
                            <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Apresentação exibida no catálogo público"></textarea>
                            <span asp-validation-for="Descricao" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Whatsapp" class="form-label"></label>
                            <input asp-for="Whatsapp" class="form-control" placeholder="5511999999999" />
                            <span asp-validation-for="Whatsapp" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EmailContato" class="form-label"></label>
                            <input asp-for="EmailContato" class="form-control" placeholder="contato@loja.com" />
                            <span asp-validation-for="EmailContato" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="InstagramUrl" class="form-label"></label>
                            <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/minhaloja" />
                            <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="Ativa" class="form-check-input" />
                                <label asp-for="Ativa" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="col-12"><hr /><h5 class="card-title px-0">Atendimento e origem das entregas</h5></div>

                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="RetiradaAtiva" class="form-check-input" />
                                <label asp-for="RetiradaAtiva" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="EntregaAtiva" class="form-check-input" />
                                <label asp-for="EntregaAtiva" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="CepOrigem" class="form-label"></label>
                            <input asp-for="CepOrigem" class="form-control" />
                            <span asp-validation-for="CepOrigem" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EnderecoOrigem" class="form-label"></label>
                            <input asp-for="EnderecoOrigem" class="form-control" />
                            <span asp-validation-for="EnderecoOrigem" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NumeroOrigem" class="form-label"></label>
                            <input asp-for="NumeroOrigem" class="form-control" />
                            <span asp-validation-for="NumeroOrigem" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ComplementoOrigem" class="form-label"></label>
                            <input asp-for="ComplementoOrigem" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BairroOrigem" class="form-label"></label>
                            <input asp-for="BairroOrigem" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="MunicipioOrigem" class="form-label"></label>
                            <input asp-for="MunicipioOrigem" class="form-control" />
                            <span asp-validation-for="MunicipioOrigem" class="text-danger"></span>
                        </div>
                        <div class="col-md-1">
                            <label asp-for="UfOrigem" class="form-label"></label>
                            <input asp-for="UfOrigem" class="form-control text-uppercase" maxlength="2" />
                            <span asp-validation-for="UfOrigem" class="text-danger"></span>
                        </div>

                        <div class="col-12"><hr /><h5 class="card-title px-0">Plano de consumo</h5></div>
                        <div class="col-md-4">
                            <label asp-for="PercentualConsumoEntrega" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="PercentualConsumoEntrega" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="PercentualConsumoEntrega" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssinaturaInicioEm" class="form-label"></label>
                            <input asp-for="AssinaturaInicioEm" class="form-control" />
                            <span asp-validation-for="AssinaturaInicioEm" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssinaturaTerminoEm" class="form-label"></label>
                            <input asp-for="AssinaturaTerminoEm" class="form-control" />
                            <span asp-validation-for="AssinaturaTerminoEm" class="text-danger"></span>
                            <div class="form-text">A vigência deve ser de exatamente 12 meses.</div>
                        </div>

                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Salvar</button>
                            <a class="btn btn-light" asp-action="Index">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Prévia</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" alt="Prévia do logo" class="img-fluid mb-3" style="max-height: 120px" />
                    }
                    <div class="rounded p-3" style="background-color: @Model.CorPrimaria; color: @Model.CorSecundaria">
                        @(string.IsNullOrWhiteSpace(Model.Nome) ? "Nome da loja" : Model.Nome)
                        @if (!string.IsNullOrWhiteSpace(Model.Descricao))
                        {
                            <div class="small mt-2">@Model.Descricao</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const seletorCor = document.getElementById('seletorCor');
        const valorCor = document.getElementById('valorCor');
        const seletorCorSecundaria = document.getElementById('seletorCorSecundaria');
        const valorCorSecundaria = document.getElementById('valorCorSecundaria');
        seletorCor.addEventListener('input', () => valorCor.value = seletorCor.value);
        valorCor.addEventListener('input', () => {
            if (/^#[0-9a-fA-F]{6}$/.test(valorCor.value)) seletorCor.value = valorCor.value;
        });
        seletorCorSecundaria.addEventListener('input', () => valorCorSecundaria.value = seletorCorSecundaria.value);
        valorCorSecundaria.addEventListener('input', () => {
            if (/^#[0-9a-fA-F]{6}$/.test(valorCorSecundaria.value)) seletorCorSecundaria.value = valorCorSecundaria.value;
        });
    </script>
}
