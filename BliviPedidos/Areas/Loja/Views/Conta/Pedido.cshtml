@model PedidoConsumidorDetalheViewModel
@{
    ViewData["Title"] = "Pedido " + Model.CodigoPublico;
    ViewData["LojaNome"] = Model.Loja.Nome;
    ViewData["LojaSlug"] = Model.Loja.Slug;
    ViewData["LojaLogo"] = Model.Loja.LogoUrl;
    ViewData["LojaCorPrimaria"] = Model.Loja.CorPrimaria;
    ViewData["LojaCorSecundaria"] = Model.Loja.CorSecundaria;
    var whatsappNumero = string.IsNullOrWhiteSpace(Model.Loja.Whatsapp)
        ? string.Empty
        : new string(Model.Loja.Whatsapp.Where(char.IsDigit).ToArray());
    if (whatsappNumero.Length is 10 or 11)
    {
        whatsappNumero = $"55{whatsappNumero}";
    }
    var mensagemComprovante = Uri.EscapeDataString(
        $"Olá! Acabei de pagar o pedido {Model.CodigoPublico} via PIX e gostaria de enviar o comprovante.");
    var whatsappComprovanteUrl = whatsappNumero.Length >= 12
        ? $"https://wa.me/{whatsappNumero}?text={mensagemComprovante}"
        : null;
}

<section class="container py-5">
    <a class="text-decoration-none" href="@Url.RouteUrl("MeusPedidosConsumidorLoja", new { lojaSlug = Model.Loja.Slug })">&larr; Meus pedidos</a>
    <div class="bg-white border rounded-3 shadow-sm p-4 mt-3">
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div><span class="text-secondary d-block">Pedido</span><strong>#@Model.PedidoId</strong></div>
            <div><span class="text-secondary d-block">Código</span><strong class="font-monospace">@Model.CodigoPublico</strong></div>
            <div><span class="text-secondary d-block">Status</span><strong>@Model.Status</strong></div>
            <div><span class="text-secondary d-block">Pagamento</span><strong>@Model.StatusPagamento</strong></div>
        </div>
        <hr />
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Imagem</th><th>Produto</th><th>Quantidade</th><th>Preço</th><th>Subtotal</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Itens)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrWhiteSpace(item.Foto) ? Url.Content("~/img/default.png") : item.Foto)" referrerpolicy="no-referrer"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/img/default.png")';"
                                 alt="@item.Produto" width="56" height="56" class="rounded border object-fit-cover" loading="lazy" />
                        </td>
                        <td>@item.Produto</td><td>@item.Quantidade</td><td>@item.PrecoUnitario.ToString("C")</td><td>@item.Subtotal.ToString("C")</td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><th colspan="4">Total</th><th>@Model.Total.ToString("C")</th></tr></tfoot>
            </table>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.PixQrCodeBase64) && !string.IsNullOrWhiteSpace(Model.PixCopiaECola))
        {
            <hr />
            <div class="text-center">
                <h2 class="h4">Pagar com PIX</h2>
                <img src="data:image/png;base64,@Model.PixQrCodeBase64" alt="QR Code PIX do pedido" class="img-fluid mb-3" style="max-width: 280px" />
                <div class="input-group mx-auto" style="max-width: 760px">
                    <input id="pixCopiaECola" class="form-control font-monospace" value="@Model.PixCopiaECola" readonly />
                    <button class="btn btn-outline-primary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('pixCopiaECola').value)">Copiar</button>
                </div>
                <div class="alert alert-success border-success text-start mx-auto mt-4" role="alert" style="max-width: 760px">
                    <div class="d-flex gap-3 align-items-start">
                        <i class="bi bi-whatsapp fs-2" aria-hidden="true"></i>
                        <div>
                            <h3 class="h5 alert-heading mb-2">Após pagar, envie o comprovante</h3>
                            <p class="mb-3">
                                Envie o comprovante do PIX pelo WhatsApp da loja. Você pode usar o ícone verde
                                disponível no Balcão Online.
                            </p>
                            @if (whatsappComprovanteUrl != null)
                            {
                                <a class="btn btn-success"
                                   href="@whatsappComprovanteUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    <i class="bi bi-whatsapp me-2" aria-hidden="true"></i>Enviar comprovante
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Model.PagamentoErro))
        {
            <div class="alert alert-warning mt-3">@Model.PagamentoErro</div>
        }
    </div>
</section>
