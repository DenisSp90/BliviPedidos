@model MeusPedidosConsumidorViewModel
@{
    ViewData["Title"] = "Meus pedidos";
    ViewData["LojaNome"] = Model.Loja.Nome;
    ViewData["LojaSlug"] = Model.Loja.Slug;
    ViewData["LojaLogo"] = Model.Loja.LogoUrl;
    ViewData["LojaCorPrimaria"] = Model.Loja.CorPrimaria;
    ViewData["LojaCorSecundaria"] = Model.Loja.CorSecundaria;
}

<section class="container py-5">
    <h1 class="h3 mb-4">Meus pedidos</h1>
    @if (Model.Pedidos.Count == 0)
    {
        <div class="alert alert-light border">Você ainda não possui pedidos nesta loja.</div>
    }
    else
    {
        <div class="table-responsive bg-white border rounded-3 shadow-sm">
            <table class="table align-middle mb-0">
                <thead><tr><th>Código</th><th>Data</th><th>Pedido</th><th>Pagamento</th><th>Total</th><th></th></tr></thead>
                <tbody>
                @foreach (var pedido in Model.Pedidos)
                {
                    <tr>
                        <td class="font-monospace">@pedido.CodigoPublico</td>
                        <td>@pedido.DataPedido?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pedido.Status</td>
                        <td>@pedido.StatusPagamento</td>
                        <td>@pedido.Total.ToString("C")</td>
                        <td><a class="btn btn-sm btn-outline-primary" href="@Url.RouteUrl("PedidoConsumidorDetalheLoja", new { lojaSlug = Model.Loja.Slug, codigoPublico = pedido.CodigoPublico })">Detalhes</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
