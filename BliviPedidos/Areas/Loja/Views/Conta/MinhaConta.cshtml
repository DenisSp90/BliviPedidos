@model MinhaContaConsumidorViewModel
@{
    ViewData["Title"] = "Minha conta";
    ViewData["LojaNome"] = Model.Loja.Nome;
    ViewData["LojaSlug"] = Model.Loja.Slug;
    ViewData["LojaLogo"] = Model.Loja.LogoUrl;
    ViewData["LojaCorPrimaria"] = Model.Loja.CorPrimaria;
    ViewData["LojaCorSecundaria"] = Model.Loja.CorSecundaria;
}

<section class="container py-5">
    <div class="mb-4">
        <h1 class="h3 mb-1">Minha conta</h1>
        <p class="text-muted mb-0">Atualize seus dados pessoais e sua senha.</p>
    </div>

    @if (TempData["ContaSucesso"] is string sucesso)
    {
        <div class="alert alert-success">@sucesso</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Informações pessoais</h2>
                    <form method="post" action="@Url.RouteUrl("EditarDadosConsumidorLoja", new { lojaSlug = Model.Loja.Slug })" class="row g-3">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="col-12">
                            <label asp-for="Dados.Nome" class="form-label"></label>
                            <input asp-for="Dados.Nome" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Dados.Nome" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Dados.Celular" class="form-label"></label>
                            <input asp-for="Dados.Celular" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="Dados.Celular" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Dados.Email" class="form-label"></label>
                            <input asp-for="Dados.Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Dados.Email" class="text-danger"></span>
                        </div>
                        <div class="col-12"><button type="submit" class="btn btn-primary">Salvar informações</button></div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Alterar senha</h2>
                    <form method="post" action="@Url.RouteUrl("AlterarSenhaConsumidorLoja", new { lojaSlug = Model.Loja.Slug })" class="row g-3">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="col-12">
                            <label asp-for="Senha.SenhaAtual" class="form-label"></label>
                            <input asp-for="Senha.SenhaAtual" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Senha.SenhaAtual" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Senha.NovaSenha" class="form-label"></label>
                            <input asp-for="Senha.NovaSenha" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Senha.NovaSenha" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Senha.ConfirmarNovaSenha" class="form-label"></label>
                            <input asp-for="Senha.ConfirmarNovaSenha" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Senha.ConfirmarNovaSenha" class="text-danger"></span>
                        </div>
                        <div class="col-12"><button type="submit" class="btn btn-outline-primary">Alterar senha</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
