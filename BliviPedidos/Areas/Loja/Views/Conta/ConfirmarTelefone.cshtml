@model ConfirmarTelefoneConsumidorViewModel
@{
    ViewData["Title"] = "Confirmar telefone";
    ViewData["LojaNome"] = Model.Loja.Nome;
    ViewData["LojaSlug"] = Model.Loja.Slug;
    ViewData["LojaLogo"] = Model.Loja.LogoUrl;
    ViewData["LojaCorPrimaria"] = Model.Loja.CorPrimaria;
    ViewData["LojaCorSecundaria"] = Model.Loja.CorSecundaria;
}
<section class="container py-5" style="max-width: 560px">
    <div class="card border-0 shadow-sm"><div class="card-body p-4">
        <h1 class="h4">Confirme seu telefone</h1>
        <p class="text-secondary">Informe o código enviado por SMS.</p>
        <form method="post">
            <input asp-for="UsuarioId" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="Codigo" class="form-label"></label>
            <input asp-for="Codigo" class="form-control mb-2" autocomplete="one-time-code" />
            <span asp-validation-for="Codigo" class="text-danger"></span>
            <button class="btn btn-primary w-100 mt-3" type="submit">Confirmar telefone</button>
        </form>
    </div></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
