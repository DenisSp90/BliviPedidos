@page
@model RegisterModel
@{
    ViewData["Title"] = "Novo usuário";
}

<div class="pagetitle">
    <h1>Novo usuário</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item">Usuários</li>
            <li class="breadcrumb-item active">Cadastro</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        Criar usuário interno
                    </h5>

                    <div class="row">
                        <div class="col-md-4">
                            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                @if (TempData["UsuarioCriado"] is string mensagem)
                                {
                                    <div class="alert alert-success">@mensagem</div>
                                }
                                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                    <label asp-for="Input.Email">Email</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                                <div class="form-floating mb-3">
                                    <select asp-for="Input.LojaId" asp-items="Model.Lojas" class="form-select" aria-required="true">
                                        <option value="">Selecione a loja</option>
                                    </select>
                                    <label asp-for="Input.LojaId"></label>
                                    <span asp-validation-for="Input.LojaId" class="text-danger"></span>
                                </div>
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                    <label asp-for="Input.Password">Password</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Criar usuário</button>
                            </form>
                        </div>
                        <div class="col-md-6 col-md-offset-2">
                            <section>
                                <h3>Console administrativo</h3>
                                <hr />
                                <p>O usuário será criado na loja selecionada e poderá acessar somente os dados dessa loja.</p>
                                <p>A conta será criada com o e-mail já confirmado. Oriente o usuário a trocar a senha no primeiro acesso.</p>
                            </section>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
