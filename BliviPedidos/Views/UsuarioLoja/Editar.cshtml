@model BliviPedidos.Models.ViewModels.EditarUsuarioLojaViewModel
@{ ViewData["Title"] = "Editar usuário da loja"; }
<div class="pagetitle"><h1>Editar usuário</h1></div>
<section class="section"><div class="row"><div class="col-lg-8"><div class="card"><div class="card-body">
    <h5 class="card-title">@(Model.Interno ? "Usuário interno" : "Consumidor")</h5>
    @if (Model.UsuarioAtual) { <div class="alert alert-info">Você pode atualizar seus dados, mas não pode alterar o próprio perfil ou desativar a conta.</div> }
    <form method="post" asp-route-id="@Model.Id" class="row g-3">
        <input asp-for="Id" type="hidden" /><input asp-for="Interno" type="hidden" /><input asp-for="UsuarioAtual" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-12"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" /><span asp-validation-for="Telefone" class="text-danger"></span></div>
        @if (Model.Interno)
        {
            <div class="col-12"><label asp-for="Perfil" class="form-label"></label><select asp-for="Perfil" asp-items="ViewBag.Perfis" class="form-select" disabled="@Model.UsuarioAtual"></select>@if (Model.UsuarioAtual) { <input asp-for="Perfil" type="hidden" /> }<span asp-validation-for="Perfil" class="text-danger"></span></div>
        }
        <div class="col-12"><div class="form-check form-switch"><input asp-for="Ativo" class="form-check-input" disabled="@Model.UsuarioAtual" />@if (Model.UsuarioAtual) { <input asp-for="Ativo" type="hidden" /> }<label asp-for="Ativo" class="form-check-label"></label></div></div>
        <div class="col-12"><button class="btn btn-primary">Salvar</button> <a asp-action="Index" class="btn btn-light">Cancelar</a></div>
    </form>
</div></div></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
