@using System.Text.RegularExpressions;
@model BliviPedidos.Models.ViewModels.StoreViewModel;
@{
    ViewData["Title"] = "Lista de Pedido | Store (Loja)";
}
<div class="pagetitle">
    <h1>Lista do Pedidos</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Página Inicial</a></li>
            <li class="breadcrumb-item"><a asp-controller="Store" asp-action="PedidoLista" asp-route-filtro="1">Pedidos</a></li>
            <li class="breadcrumb-item active">Lista de pedidos registrados</li>
        </ol>
    </nav>
</div>
<section class="section dashboard">
    <div class="row">
        <div class="col-9 col-lg-9">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Lista de pedidos</h5>
                    <p>
                        A lista apresenta todos os pedidos confirmados, inclusive concluídos e cancelados. Carrinhos ainda não finalizados não entram na contagem.
                    </p>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <a asp-action="PedidoPreparacao" class="btn btn-primary">
                                <i class="bi bi-cart-plus"></i> Novo pedido
                            </a>
                        </div>
                        <div class="col-md-6 d-flex justify-content-md-end">
                            <div>
                                @{
                                    var cssFiltro = Model.FiltroRegistros == 2 ? "btn btn-primary btn-sm" : "btn btn-light btn-sm";
                                }
                                <a asp-action="PedidoLista" asp-route-filtro="2" class="@cssFiltro">
                                    Meus Pedidos
                                </a>
                                @{
                                    cssFiltro = Model.FiltroRegistros == 1 ? "btn btn-primary btn-sm" : "btn btn-light btn-sm";
                                }
                                <a asp-action="PedidoLista" asp-route-filtro="1" class="@cssFiltro">
                                    Todos Pedidos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body pt-0">
                    <form asp-action="PedidoLista" method="get" class="row g-2 align-items-end">
                        <input type="hidden" name="filtro" value="@Model.FiltroRegistros" />
                        <div class="col-md-8 col-lg-6">
                            <label for="busca" class="form-label">Localizar pedido</label>
                            <input id="busca" name="busca" value="@Model.BuscaPedido" class="form-control"
                                   placeholder="Número interno ou código público" />
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Buscar</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.BuscaPedido))
                        {
                            <div class="col-auto">
                                <a asp-action="PedidoLista" asp-route-filtro="@Model.FiltroRegistros" class="btn btn-light">Limpar</a>
                            </div>
                        }
                    </form>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="datatable table">
                            <thead>
                                <tr>
                                    <th>Ação</th>
                                    <th>N°</th>
                                    <th>Código público</th>
                                    <th>Pago</th>
                                    <th>Nome</th>
                                    <th>Total</th>
                                    <th>Feito</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Pedidos)
                                {
                                    var hoje = DateTime.Now;
                                    var classeLinha = (p.StatusPagamento != StatusPagamento.Pago && p.DataPedido < hoje) ? "table-danger" : "";

                                    string numeroTelefone = new String(p.Cadastro.Telefone.Where(Char.IsDigit).ToArray());
                                    string linkWhatsApp = "https://api.whatsapp.com/send?phone=" + numeroTelefone +
                                    "&text=Recebemos%20seu%20pedido%20" + Uri.EscapeDataString(p.CodigoPublico ?? p.Id.ToString());

                                    <tr class="@classeLinha">
                                        <td>
                                            <a asp-action="PedidoDetalhe" asp-route-id="@p.Id" class="btn btn-primary btn-sm">
                                                <i class="bi bi-info-circle"></i>
                                            </a>
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => p.Id)</td>
                                        <td class="font-monospace">@(p.CodigoPublico ?? "-")</td>
                                        <td>
                                            @if (p.StatusPagamento == StatusPagamento.Pago)
                                            {
                                                <span class="badge rounded-pill bg-success">Pago</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-warning text-dark">Pendente</span>
                                            }
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => p.Cadastro.Nome)</td>
                                        <td>
                                            @{
                                                var subTotal = p.Itens.Sum(x => Convert.ToDecimal(x.Subtotal));
                                            }
                                            @Html.DisplayFor(modelItem => subTotal)
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => p.DataPedido)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="bi bi-house"></i> Voltar ao início
                    </a>
                </div>
            </div>
        </div>
        <div class="col-3 col-lg-3">
            <div class="row">

                @{
                    var pa = 0;
                    var valorPrevisto = Convert.ToDecimal(0);
                    var valorPago = Convert.ToDecimal(0);

                    decimal totalLucroTodosPedidos = Model.Pedidos.Sum(p =>
                        p.Itens.Sum(item =>
                            (item.PrecoUnitario - item.Produto.PrecoPago) * item.Quantidade));

                    var totalLucroPedidosPagos = Model.Pedidos
                        .Where(p => p.StatusPagamento == StatusPagamento.Pago)
                        .Sum(p => p.Itens.Sum(item =>
                            (item.PrecoUnitario - item.Produto.PrecoPago) * item.Quantidade));

                    if (Model.Pedidos.Count != 0)
                    {
                        valorPrevisto = Model.Pedidos.Sum(x =>
                            Convert.ToDecimal(x.ValorTotalPedido));

                        valorPago = Model.Pedidos
                            .Where(p => p.StatusPagamento == StatusPagamento.Pago)
                            .Sum(x => Convert.ToDecimal(x.ValorTotalPedido));

                        if (valorPago != 0)
                            pa = Convert.ToInt32(
                                Math.Abs((valorPago / valorPrevisto) * 100));
                        else
                            pa = 0;
                    }
                }

                <!-- PEDIDOS -->
                <div class="col-12">
                    <div class="card info-card sales-card">
                        <div class="card-body">

                            <h5 class="card-title">
                                Pedidos <span>| Em andamento</span>
                            </h5>

                            <div class="d-flex align-items-center">

                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-cart"></i>
                                </div>

                                <div class="ps-3">
                                    <h6>@Model.Pedidos.Count</h6>

                                    <span class="text-success small pt-1 fw-bold">
                                        Registrados no filtro atual
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                <!-- LUCRO -->
                <div class="col-12">
                    <div class="card info-card sales-card">
                        <div class="card-body">

                            <h5 class="card-title">
                                Lucro <span>| Recebido</span>
                            </h5>

                            <div class="d-flex align-items-center">

                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-sort-numeric-up-alt"></i>
                                </div>

                                <div class="ps-3">
                                    <h6>
                                        @string.Format("{0:0.00}", totalLucroPedidosPagos)
                                    </h6>

                                    <span class="text-secondary small pt-1 fw-bold">
                                        Lucro recebido
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                <!-- VALORES RECEBIDOS -->
                <div class="col-12">
                    <div class="card info-card sales-card">
                        <div class="card-body">

                            <h5 class="card-title">
                                Valores <span>| Recebidos</span>
                            </h5>

                            <div class="d-flex align-items-center">

                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-currency-dollar"></i>
                                </div>

                                <div class="ps-3">
                                    <h6>
                                        @string.Format("{0:0.00}", valorPago)
                                    </h6>

                                    <span class="text-secondary small pt-1 fw-bold">
                                        @pa.ToString()% pagos
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                <!-- TOTAL PREVISTO -->
                <div class="col-12">
                    <div class="card info-card revenue-card">
                        <div class="card-body">

                            <h5 class="card-title">
                                Total <span>| previsto</span>
                            </h5>

                            <div class="d-flex align-items-center">

                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-currency-dollar"></i>
                                </div>

                                <div class="ps-3">

                                    <h6>
                                        @(Model.Pedidos
                                            .Sum(x => Convert.ToDecimal(x.ValorTotalPedido))
                                            .ToString("0.00"))
                                    </h6>

                                    <span class="text-secondary small pt-1 fw-bold">
                                        Total previsto
                                    </span>

                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>    
</section>

