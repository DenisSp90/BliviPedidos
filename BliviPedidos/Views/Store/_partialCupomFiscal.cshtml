@model BliviPedidos.Models.ViewModels.StoreViewModel

<!DOCTYPE html>
<html>
<head>
    <title>Cupom Fiscal</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        .cupom {
            border: 1px solid #000;
            padding: 5px;
            width: 300px; /* Ajuste para largura fixa */
            margin: 0 auto;
        }

        .cabecalho, .rodape {
            text-align: center; /* Centraliza o texto */
            margin-bottom: 5px; /* Reduza o espaçamento */
        }

        .itens {
            margin-bottom: 5px;
        }

        .item {
            margin-bottom: 2px; /* Reduza o espaçamento */
            font-size: 11px;
        }

        .subtotal {
            margin-top: 5px;
            text-align: right;
            font-weight: bold;
        }

        /* Estilos específicos para impressão */
        @@media print {
            body {
                margin: 0;
            }

            .cupom {
                width: 100%; /* Use toda a largura disponível na impressão */
                border: none; /* Remova bordas para economizar espaço */
            }

            .rodape, .subtotal {
                margin-top: 0;
            }

            img {
                max-width: 100%; /* Garantir que o QR code se ajuste à largura da página */
            }
            /* Remover elementos desnecessários na impressão */
            button {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="cupom">
        <div class="cabecalho">
            @if (!string.IsNullOrWhiteSpace(Model.Loja?.LogoUrl))
            {
                <img src="@Model.Loja.LogoUrl" alt="Logo de @Model.Loja.Nome" style="max-width: 90px; max-height: 64px; object-fit: contain;" />
            }
            <h1>@(Model.Loja?.Nome ?? "Loja")</h1>
            <strong>RECIBO DE PEDIDO</strong>
            <p>@(Model.Pedido.DataPedido?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm")) - #@(Model.Pedido.CodigoPublico ?? Model.Pedido.Id.ToString())</p>
            <p>
                <span>@Model.Pedido.Cadastro.Nome.Trim()</span>
            </p>
            <p>
                <span>@Model.Pedido.Cadastro.ResponsavelCerimar</span>

            </p>
            <p>
                <span>@Model.Pedido.Cadastro.Turma</span>
            </p>
        </div>
        <br />
        <div class="itens">
            @foreach (var i in Model.Pedido.Itens)
            {
                <div class="item">
                    <span>@i.Quantidade X </span>
                    <span>@i.Produto.Nome</span>
                    <span style="float: right;">@string.Format("{0:0.00}", i.PrecoUnitario)</span>
                </div>
            }
        </div>
        <br />
        <br />
        <div class="subtotal">
            <span style="float: right;">Subtotal: R$ @string.Format("{0:0.00}", Model.Pedido.Itens.Sum(i => i.Subtotal))</span>
        </div>
        <br />
        <div class="rodape">
            <p>Obrigado pela preferência!</p>
            @if (!string.IsNullOrWhiteSpace(Model.PixQRCodeUrl))
            {
                <p>Escaneie o QR Code para realizar o pagamento via PIX.</p>
                <img src="data:image/png;base64,@Model.PixQRCodeUrl" alt="Código QR PIX" class="img-fluid mb-3" style="max-width: 160px;">
            }
            @if (!string.IsNullOrWhiteSpace(Model.Loja?.Whatsapp))
            {
                <p>Contato: @Model.Loja.Whatsapp</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Loja?.EmailContato))
            {
                <p>@Model.Loja.EmailContato</p>
            }
            <small>Este recibo não substitui nota fiscal.</small>
        </div>
    </div>
    <div style="text-align: center; margin-top: 20px;">
        <button onclick="abrirPopup()" class="btn btn-primary">Visualizar Cupom</button>
    </div>
    <script src="~/js/controllers/Store-Cupom.js"></script>
</body>
</html>
