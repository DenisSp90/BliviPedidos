@model IEnumerable<BliviPedidos.Models.Categoria>

@{
    ViewData["Title"] = "Lista de Categorias";
}

<div class="pagetitle">
    <h1>Lista de Categorias</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Página de Inicial</a></li>
            <li class="breadcrumb-item">Categorias</li>
            <li class="breadcrumb-item active">Lista de categorias de produto</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="row">
        <div class="col-lg-12">
            <div class="row">
                <div class="col-lg-6 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Categorias<span> | Total</span></h5>

                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-collection"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>99</h6>
                                    <span class="small pt-1 fw-bold">Registrados no estoque</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Categorias<span> | Total</span></h5>

                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-collection"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>99</h6>
                                    <span class="small pt-1 fw-bold">Registrados no estoque</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Categorias</h5>

                    <div class="d-md-flex justify-content-between align-items-center">
                        
                        <div class="btn-group mb-3 mb-md-0" role="group">
                            <a class="btn btn-primary" asp-action="CategoriaCadastro"><i class="bi bi-plus"></i>&nbsp;Nova Categoria</a>
                        </div>

                        <!-- Grupo de novos botões "Ativo" e "Desativado" -->
                        <div class="btn-group mb-3 mb-md-0" role="group">
                            <a class="btn btn-primary" asp-action="CategoriaLista" asp-route-filtro="1">Categorias Ativos</a>
                            <a class="btn btn-secondary" asp-action="CategoriaLista" asp-route-filtro="2">Categorias Desativados</a>
                            <a class="btn btn-light" asp-action="CategoriaLista" asp-route-filtro="3">Todas as Categorias</a>
                        </div>
                    </div>

                    <br />
                    <div class="table-responsive">
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th>Opções</th>
                                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                                    <th>@Html.DisplayNameFor(model => model.Nome)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="btn-group">
                                                <a class="btn btn-info btn-sm" asp-action="ProdutoDetalhe" asp-route-id="@item.Id"><i class="bi bi-info-circle"></i></a>
                                                <a class="btn btn btn-danger btn-sm delete-btn" data-id="@item.Id" href="/Store/ProdutoDelete/@item.Id"><i class="bi bi-trash"></i></a>
                                            </div>
                                        </td>
                                        <td>@item.Id</td>
                                        <td>@item.Nome</td>                                        
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>