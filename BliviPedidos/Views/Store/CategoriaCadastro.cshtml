@model BliviPedidos.Models.ViewModels.CategoriaViewModel

@{
    ViewData["Title"] = "Cadastro de Categoria";
}

<div class="pagetitle">
    <h1>Cadastro de Categorias</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Página Inicial</a></li>
            <li class="breadcrumb-item"><a asp-controller="Store" asp-action="CategoriaLista">Categorias</a></li>
            <li class="breadcrumb-item active">Cadastro</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Cadastro de Categorias</h5>

                    <form class="row g-3" id="formulario" method="post" enctype="multipart/form-data" asp-action="CategoriaCadastro">

                        <div class="col-12">
                            <label asp-for="Nome" class="col-sm-6 col-form-label"></label>
                            <input asp-for="Nome" type="text" placeholder="Nome da Categoria" class="form-control">
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsAtivo" class="form-check-input" type="checkbox">
                                <label asp-for="IsAtivo" class="form-check-label">
                                    Ativo
                                </label>
                            </div>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary">Cadastrar</button>
                        </div>
                    </form>


                </div>
            </div>
        </div>
        <div class="col-lg-4">
        </div>
    </div>
</section>