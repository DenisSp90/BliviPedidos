@model BliviPedidos.Models.ViewModels.EntregaLojaViewModel

@{
    ViewData["Title"] = "Retirada e entrega";
}

<div class="pagetitle">
    <h1>Retirada e entrega</h1>
    <p class="text-muted">Configure como a @Model.LojaNome atende seus consumidores.</p>
</div>

<section class="section">
    @if (TempData["Sucesso"] is string sucesso) { <div class="alert alert-success">@sucesso</div> }
    @if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card"><div class="card-body">
                <h5 class="card-title">Modalidades e endereço de origem</h5>
                <form asp-action="Salvar" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="col-md-6 form-check form-switch ms-2">
                        <input asp-for="RetiradaAtiva" class="form-check-input" />
                        <label asp-for="RetiradaAtiva" class="form-check-label">Retirada na loja</label>
                    </div>
                    <div class="col-md-5 form-check form-switch ms-2">
                        <input asp-for="EntregaAtiva" class="form-check-input" />
                        <label asp-for="EntregaAtiva" class="form-check-label">Entrega pela loja</label>
                    </div>
                    <div class="col-md-3"><label asp-for="CepOrigem" class="form-label">CEP</label><input asp-for="CepOrigem" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="EnderecoOrigem" class="form-label">Endereço</label><input asp-for="EnderecoOrigem" class="form-control" /></div>
                    <div class="col-md-3"><label asp-for="NumeroOrigem" class="form-label">Número</label><input asp-for="NumeroOrigem" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="ComplementoOrigem" class="form-label">Complemento</label><input asp-for="ComplementoOrigem" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="BairroOrigem" class="form-label">Bairro</label><input asp-for="BairroOrigem" class="form-control" /></div>
                    <div class="col-md-3"><label asp-for="MunicipioOrigem" class="form-label">Cidade</label><input asp-for="MunicipioOrigem" class="form-control" /></div>
                    <div class="col-md-1"><label asp-for="UfOrigem" class="form-label">UF</label><input asp-for="UfOrigem" class="form-control text-uppercase" maxlength="2" /></div>
                    <div class="col-12"><button class="btn btn-primary" type="submit">Salvar configuração</button></div>
                </form>
            </div></div>

            <div class="card"><div class="card-body">
                <h5 class="card-title">Faixas de frete</h5>
                @if (Model.Faixas.Count == 0)
                {
                    <p class="text-muted">Cadastre a primeira faixa começando em 0 km.</p>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle">
                        <thead><tr><th>De</th><th>Até</th><th>Valor</th><th></th></tr></thead>
                        <tbody>@foreach (var faixa in Model.Faixas) { <tr>
                            <td>@faixa.DistanciaInicialKm.ToString("N3") km</td><td>@faixa.DistanciaFinalKm.ToString("N3") km</td>
                            <td>@faixa.ValorFrete.ToString("C")</td><td class="text-end"><form asp-action="ExcluirFaixa" asp-route-id="@faixa.Id" method="post"><button class="btn btn-sm btn-outline-danger">Excluir</button></form></td>
                        </tr> }</tbody>
                    </table></div>
                }
            </div></div>
        </div>

        <div class="col-lg-5">
            <div class="card"><div class="card-body">
                <h5 class="card-title">Nova faixa</h5>
                <form asp-action="AdicionarFaixa" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="col-6"><label class="form-label">De (km)</label><input asp-for="NovaFaixa.DistanciaInicialKm" name="DistanciaInicialKm" class="form-control" /></div>
                    <div class="col-6"><label class="form-label">Até (km)</label><input asp-for="NovaFaixa.DistanciaFinalKm" name="DistanciaFinalKm" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Valor</label><input asp-for="NovaFaixa.ValorFrete" name="ValorFrete" class="form-control" /></div>
                    <div class="col-12"><button class="btn btn-primary" type="submit">Adicionar faixa</button></div>
                </form>
            </div></div>

            <div class="card"><div class="card-body">
                <h5 class="card-title">Plano contratado</h5>
                <p class="mb-1"><strong>@Model.PercentualConsumoEntrega.ToString("N2")%</strong> sobre os fretes de entregas concluídas.</p>
                <p class="text-muted small mb-0">Vigência: @(Model.AssinaturaInicioEm?.ToString("dd/MM/yyyy") ?? "não informada") a @(Model.AssinaturaTerminoEm?.ToString("dd/MM/yyyy") ?? "não informada"). Alterações comerciais são feitas pelo administrador da plataforma.</p>
            </div></div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
