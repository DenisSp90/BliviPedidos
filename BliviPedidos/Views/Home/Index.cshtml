@{
    ViewData["Title"] = "Página Inicial";
}
@model BliviPedidos.Models.ViewModels.StoreViewModel;

<div class="pagetitle">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div>

<section id="dashboardPedidos" class="section dashboard">
    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="row">
                @{
                    var pa = 0;
                    var valorPrevisto = Convert.ToDecimal(0);
                    var valorPago = Convert.ToDecimal(0);

                    if (Model.Pedidos.Count != 0)
                    {
                        valorPrevisto = Model.Pedidos.Sum(x => Convert.ToDecimal(x.ValorTotalPedido));
                        valorPago = Model.Pedidos.Where(p => p.StatusPagamento == StatusPagamento.Pago).Sum(x => Convert.ToDecimal(x.ValorTotalPedido));

                        if (valorPago != 0)
                            pa = Convert.ToInt32(Math.Abs((valorPago / valorPrevisto) * 100));
                        else
                            pa = 0;
                    }
                }
                <div class="col-12 col-md-6 col-xxl-6">
                    <a href="@Url.Action("ProdutoLista", "Store", new { filtro = 1 })" class="text-decoration-none">
                        <div class="card info-card sales-card">
                            <div class="card-body">
                                <h5 class="card-title">Produtos <span>|</span></h5>

                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="ri ri-barcode-box-line"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@Model.Produtos.Count</h6>
                                        <span class="text-muted small pt-2 ps-1">Produtos em estoque</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xxl-6">
                    <a href="@Url.Action("PedidoLista", "Store", new { filtro = 1 })" class="text-decoration-none">
                        <div class="card info-card sales-card">
                            <div class="card-body">
                                <h5 class="card-title">Pedidos <span>| Ativos</span></h5>

                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-cart-check"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@Model.Pedidos.Count</h6>
                                        <span class="text-success small pt-1 fw-bold">@pa.ToString()%</span> <span class="text-muted small pt-2 ps-1">Pagos</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Gráficos <span>/Pedidos</span></h5>

                            <div class="flot-chart">
                                <div id="bar_chart"></div>
                            </div>

                            <div class="row text-left">
                                <div class="col-12 col-md-4 col-lg-4">
                                    <div class="m-l-md">
                                        <span id="total-valor-pedidos" class="h4 font-bold m-t block">$ @String.Format("{0:0.00}", Model.TotalValorPedidos)</span>
                                        <small class="text-muted m-b block">Total pedidos</small>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4 col-lg-4">
                                    <div class="m-l-md">
                                        <span id="valor-pedidos-pagos" class="h4 font-bold m-t block">$ @Model.ValorPedidosPagos.ToString("0.00")</span>
                                        <small class="text-muted m-b block">Pedidos Pagos</small>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4 col-lg-4">
                                    <div class="m-l-md">
                                        <span id="valor-pedidos-nao-pagos" class="h4 font-bold m-t block">$ @Model.ValorPedidosNaoPagos.ToString("0.00")</span>
                                        <small class="text-muted m-b block">Valores não pagos</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Pedidos recentes <span>| Últimos 10 lançamentos</span></h5>

                    <div class="activity">
                        @foreach (var pedido in Model.Pedidos
                            .OrderByDescending(item => item.DataPedido ?? DateTime.MinValue)
                            .ThenByDescending(item => item.Id)
                            .Take(10))
                        {
                            <div class="activity-item d-flex">
                                <div class="activite-label" style="min-width: 125px">
                                    @(pedido.DataPedido?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Data não informada")
                                </div>

                                @if (pedido.StatusPagamento == StatusPagamento.Pago)
                                {
                                    <i class='bi bi-circle-fill activity-badge text-success align-self-start'></i>
                                }
                                else
                                {
                                    <i class='bi bi-circle-fill activity-badge text-warning align-self-start'></i>
                                }

                                <div class="activity-content">
                                    <a href="@Url.Action("PedidoDetalhe", "Store", new { id = pedido.Id })" class="text-decoration-none">
                                        @pedido.Cadastro.Nome
                                    </a>
                                    <div class="small text-muted">
                                        Pedido #@pedido.Id · R$ @pedido.ValorTotalPedido.ToString("N2")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-4 mb-4 dashboard-stock-summary">
        <div class="col-12 col-sm-6 col-xl-3 d-flex">
            <div class="card info-card sales-card dashboard-stock-card w-100 mb-0">
                <div class="card-body">
                    <h5 class="card-title">Produtos ativos <span>Catálogo</span></h5>
                    <div class="dashboard-stock-metric d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="dashboard-stock-copy ps-3">
                            <h6>@Model.QuantidadeProdutosAtivos</h6>
                            <span class="text-muted small">Itens disponíveis no catálogo</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 d-flex">
            <div class="card info-card dashboard-stock-card w-100 mb-0">
                <div class="card-body">
                    <h5 class="card-title">Estoque crítico <span>Até 5 unidades</span></h5>
                    <div class="dashboard-stock-metric d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-warning-subtle text-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div class="dashboard-stock-copy ps-3">
                            <h6>@Model.QuantidadeProdutosEstoqueCritico</h6>
                            <span class="text-muted small">Produtos que precisam de atenção</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 d-flex">
            <div class="card info-card revenue-card dashboard-stock-card w-100 mb-0">
                <div class="card-body">
                    <h5 class="card-title">Custo do estoque <span>Valor de compra</span></h5>
                    <div class="dashboard-stock-metric d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div class="dashboard-stock-copy ps-3">
                            <h6>R$ @Model.CustoTotalEstoque.ToString("N2")</h6>
                            <span class="text-muted small">Capital investido atualmente</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 d-flex">
            <div class="card info-card customers-card dashboard-stock-card w-100 mb-0">
                <div class="card-body">
                    <h5 class="card-title">Margem potencial <span>Estimativa de venda</span></h5>
                    <div class="dashboard-stock-metric d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div class="dashboard-stock-copy ps-3">
                            <h6>R$ @Model.MargemPotencialEstoque.ToString("N2")</h6>
                            <span class="text-muted small">Venda potencial: R$ @Model.ValorVendaPotencialEstoque.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4 dashboard-stock-charts">
        <div class="col-12 col-xl-7 d-flex">
            <div class="card dashboard-stock-chart-card w-100 mb-0">
                <div class="card-body">
                    <h5 class="card-title">Produtos mais vendidos <span>| Últimos 30 dias</span></h5>
                    <div id="graficoProdutosMaisVendidos" style="min-height: 340px"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5 d-flex">
            <div class="card dashboard-stock-chart-card w-100 mb-0">
                <div class="card-body">
                    <h5 class="card-title">Estoque por categoria <span>| Unidades</span></h5>
                    <div id="graficoEstoqueCategoria" style="min-height: 340px"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card mb-0">
                <div class="card-body">
                    <h5 class="card-title">Produtos que precisam de reposição <span>| Até 5 unidades</span></h5>

                    @if (Model.ProdutosEstoqueCritico.Count == 0)
                    {
                        <div class="alert alert-success mb-0" role="status">
                            <i class="bi bi-check-circle me-1"></i>
                            Nenhum produto ativo está com estoque crítico.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Produto</th>
                                        <th>Categoria</th>
                                        <th class="text-end">Quantidade</th>
                                        <th class="text-end">Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var produto in Model.ProdutosEstoqueCritico)
                                    {
                                        <tr>
                                            <td>@produto.Nome</td>
                                            <td>@produto.Categoria</td>
                                            <td class="text-end">
                                                <span class="badge @(produto.Quantidade <= 0 ? "bg-danger" : "bg-warning text-dark")">
                                                    @produto.Quantidade
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary"
                                                   asp-controller="Store" asp-action="ProdutoEditar" asp-route-id="@produto.Id">
                                                    Repor estoque
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12">

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Consulte a movimentação do estoque</h5>
                    <table class="table datatable" style="font-size: 12px;">
                        <thead>
                            <tr>
                                <th scope="col">Data</th>
                                <th scope="col">Produto</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Quantidade</th>
                                <th scope="col">Observação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Movimentacoes)
                            {
                                <tr>
                                    <th scope="row">@m.Data</th>
                                    <td>@m.Produto.Nome.Trim()</td>

                                    <td>
                                        @if (m.Tipo == "Entrada")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-arrow-down-short me-1"></i> Entrada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-arrow-up-short"></i> Saida</span>
                                        }
                                    </td>

                                    <td>@m.Quantidade</td>
                                    <td>@m.Observacao.Trim()</td>
                                </tr>
                            }

                        </tbody>
                    </table>


                </div>
                <div class="card-footer">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="bi bi-house"></i> Voltar ao início
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script src="~/js/controllers/Store-Grafico.js"></script>
<script id="dashboardEstoqueDados" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        produtosMaisVendidos = Model.ProdutosMaisVendidos.Select(item => new { rotulo = item.Rotulo, valor = item.Valor }),
        estoquePorCategoria = Model.EstoquePorCategoria.Select(item => new { rotulo = item.Rotulo, valor = item.Valor })
    }))
</script>
<script src="~/js/controllers/Dashboard-Estoque.js" asp-append-version="true"></script>
