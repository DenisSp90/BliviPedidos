@{
    ViewData["Title"] = "Backup e restauração";
}

<div class="pagetitle">
    <h1>Backup e restauração</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Página Inicial</a></li>
            <li class="breadcrumb-item active">Backup e restauração</li>
        </ol>
    </nav>
</div>

<section class="section">
    @if (TempData["BackupSucesso"] is string sucesso)
    {
        <div class="alert alert-success" role="alert">@sucesso</div>
    }
    @if (TempData["BackupErro"] is string erro)
    {
        <div class="alert alert-danger" role="alert">@erro</div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Gerar backup da loja</h5>
                    <p>
                        O arquivo ZIP inclui categorias, produtos, estoque, clientes, pedidos,
                        itens, movimentações e as imagens salvas no servidor para esta loja.
                    </p>

                    <div class="alert alert-info" role="alert">
                        Por segurança, senhas, contas de acesso e a chave PIX não são incluídas.
                    </div>

                    <form asp-action="Gerar" method="post">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-download me-1"></i>Gerar e baixar backup
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Restaurar backup</h5>
                    <div class="alert alert-warning" role="alert">
                        Esta ação substituirá categorias, produtos, estoque, clientes, pedidos,
                        movimentações e imagens atuais desta loja.
                    </div>

                    <form asp-action="Restaurar" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="arquivo" class="form-label">Arquivo ZIP</label>
                            <input id="arquivo" name="arquivo" type="file" accept=".zip,application/zip"
                                   class="form-control" required />
                            <div class="form-text">Tamanho máximo: 100 MB.</div>
                        </div>

                        <div class="form-check mb-3">
                            <input id="confirmarSubstituicao" name="confirmarSubstituicao" value="true"
                                   class="form-check-input" type="checkbox" required />
                            <label for="confirmarSubstituicao" class="form-check-label">
                                Entendo que os dados atuais serão substituídos.
                            </label>
                        </div>

                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Restaurar backup
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
